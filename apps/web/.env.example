# =============================================================================
# EduConnect Web (Vercel) — plantilla de variables de entorno
#
# ⚠ Todo lo que empieza con NEXT_PUBLIC_ termina en el JavaScript del
#   navegador: SOLO valores públicos. Aquí NO van service_role, sk_, whsec_,
#   ni la API key de Daily.
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase: URL y clave PUBLICABLE (sb_publishable_… o anon). Protegida por RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stripe: clave PUBLICABLE (pk_test_… / pk_live_…)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Daily: solo el subdominio (para CSP y Permissions-Policy)
NEXT_PUBLIC_DAILY_DOMAIN=educonnect

# Cloudflare Turnstile: site key pública. La secret key se configura en
# Supabase → Authentication → Bot and Abuse Protection (no aquí).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
