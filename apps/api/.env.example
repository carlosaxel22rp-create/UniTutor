# =============================================================================
# EduConnect API (Render) — plantilla de variables de entorno
# Copiar a .env SOLO en local. En Render: Environment → Secret Files / Env Vars.
# NUNCA commitear .env (ya está en .gitignore). Rotar cualquier secreto expuesto.
# =============================================================================

NODE_ENV=development            # development | test | production
PORT=4000
LOG_LEVEL=info                  # en producción: info (nunca debug con datos reales)

# Orígenes permitidos por CORS (coma-separados, sin barra final, exactos)
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# SECRETO CRÍTICO: omite RLS. Solo en el servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Solo si el proyecto aún usa el secreto JWT HS256 legado. Con claves de firma
# asimétricas (recomendado) dejar vacío: se usa el JWKS público.
SUPABASE_JWT_SECRET=

# --- Stripe (modo test en local/staging: sk_test_…) --------------------------
# Preferir una Restricted Key (rk_) con permisos mínimos: PaymentIntents,
# Customers, Refunds, Transfers, Accounts, Account Links (write).
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_            # endpoint /webhooks/stripe
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_    # endpoint /webhooks/stripe/connect
PLATFORM_FEE_BPS=1500                   # 1500 = 15 % de comisión
CURRENCY=mxn

# --- Daily.co ------------------------------------------------------------------
DAILY_API_KEY=
DAILY_DOMAIN=educonnect                 # <DAILY_DOMAIN>.daily.co
DAILY_WEBHOOK_HMAC=                     # secreto base64 del webhook (POST /webhooks)

# --- Redis (rate limiting distribuido; obligatorio en producción) --------------
# Usar TLS (rediss://) en producción.
REDIS_URL=redis://localhost:6379
